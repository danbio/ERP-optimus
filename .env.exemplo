# Copie para .env (na mesma pasta do manage.py) e preencha. O .env não vai para o Git (D36).
# Gerar uma chave nova no PowerShell, com o .venv ativo:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cole-aqui-a-chave-gerada
# 0 = produção (erros não mostram o código). 1 = desenvolvimento.
DEBUG=0
